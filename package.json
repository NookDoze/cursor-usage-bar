{
  "name": "cursor-usage-bar",
  "displayName": "Cursor Usage Bar",
  "description": "Show Cursor Models / Other Models usage and on-demand spend in the status bar with auto-refresh",
  "version": "0.3.7",
  "publisher": "NookDoze",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/NookDoze/cursor-usage-bar"
  },
  "bugs": {
    "url": "https://github.com/NookDoze/cursor-usage-bar/issues"
  },
  "homepage": "https://github.com/NookDoze/cursor-usage-bar#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": [
    "cursor",
    "usage",
    "billing",
    "cursor-models",
    "other-models",
    "status bar",
    "spending",
    "quota",
    "on-demand"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursorUsageBar.refresh",
        "title": "Cursor Usage Bar: Refresh Usage"
      },
      {
        "command": "cursorUsageBar.openDashboard",
        "title": "Cursor Usage Bar: Open Usage Dashboard"
      }
    ],
    "configuration": {
      "title": "Cursor Usage Bar",
      "properties": {
        "cursorUsageBar.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Auto-refresh interval in seconds (minimum 15)"
        },
        "cursorUsageBar.stateDbPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to Cursor state.vscdb (leave empty for auto-detection)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
